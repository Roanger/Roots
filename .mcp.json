{
  "mcpServers": {
    "godot-mcp": {
      "command": "npx",
      "args": ["-y", "@satelliteoflove/godot-mcp"],
      "env": {
        "GODOT_MCP_USAGE_LOG": "0",
        "GODOT_MCP_VERBOSE": "0"
      }
    },
    "blender-mcp": {
      "command": "uvx",
      "args": ["blender-mcp"]
    }
  }
}
